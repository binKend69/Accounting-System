<Application x:Class="MotoParts.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Converters.xaml" />
                <ResourceDictionary Source="Views/PageTemplates.xaml" />
                <ResourceDictionary Source="Views/Forms/StockFormsViews.xaml" />
                <ResourceDictionary Source="Views/AccountingTemplates.xaml" />
                <ResourceDictionary Source="Views/StaffAdminTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
