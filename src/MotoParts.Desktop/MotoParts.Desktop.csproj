<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MotoParts.Desktop</RootNamespace>
    <AssemblyName>MotoParts</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Themes/app.ico</ApplicationIcon>
    <Description>نظام المحاسبة والمخزون ونقطة البيع لمحل قطع غيار الدراجات النارية</Description>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotoParts.Core\MotoParts.Core.csproj" />
    <ProjectReference Include="..\MotoParts.Documents\MotoParts.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="اقرأني.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
