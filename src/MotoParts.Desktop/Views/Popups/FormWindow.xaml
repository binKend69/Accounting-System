<Window x:Class="MotoParts.Desktop.Views.Popups.FormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MotoParts.Desktop.Views.Controls"
        Title="{Binding Title}"
        FlowDirection="RightToLeft"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Height"
        MaxHeight="900"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,14">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
            <StackPanel>
                <ContentControl Content="{Binding}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="22,12">
            <StackPanel>
                <controls:StatusBanner />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" MinWidth="120"
                            Margin="0,0,8,0" Click="OnSave" Visibility="{Binding CanSave, Converter={StaticResource Visible}}" />
                    <Button x:Name="CancelButton" Content="إلغاء" MinWidth="100" IsCancel="True" />
                    <TextBlock Text="جارٍ الحفظ..." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
