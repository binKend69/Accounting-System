<Window x:Class="MotoParts.Desktop.Views.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول"
        FlowDirection="RightToLeft"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource Sidebar}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Width="900" Height="580">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <StackPanel VerticalAlignment="Center" Margin="48,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE804;" FontSize="54" Foreground="White" HorizontalAlignment="Left" />
            <TextBlock x:Name="ShopName" Text="نظام إدارة محل قطع الغيار" Foreground="White" FontSize="28"
                       FontWeight="SemiBold" Margin="0,18,0,8" TextWrapping="Wrap" />
            <TextBlock Text="المبيعات والمخزون والحسابات والموظفون في مكان واحد"
                       Foreground="{StaticResource SidebarText}" FontSize="15" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Sign-in card -->
        <Border Grid.Column="1" Background="{StaticResource Surface}" Padding="40,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="تسجيل الدخول" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24" />

                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="Username" FlowDirection="LeftToRight" Margin="0,0,0,14" />

                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="Password" FlowDirection="LeftToRight" Margin="0,0,0,8" />

                <Border x:Name="ErrorBox" Background="{StaticResource DangerSoft}" CornerRadius="5" Padding="10,8"
                        Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>

                <Button x:Name="SignInButton" Content="دخول" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Margin="0,20,0,0" MinHeight="42" FontSize="15" Click="OnSignIn" />

                <TextBlock x:Name="CapsHint" Text="تنبيه: زر الأحرف الكبيرة (Caps Lock) مفعّل" Foreground="{StaticResource Warning}"
                           Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
