<Window x:Class="MotoParts.Desktop.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:MotoParts.Desktop.Views.Shell"
        Title="{Binding ShopName}"
        FlowDirection="RightToLeft"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1100" MinHeight="680"
        Width="1366" Height="768">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar (on the right in RTL) ================= -->
        <Grid Background="{StaticResource Sidebar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="18,18,18,10">
                <TextBlock Text="{Binding ShopName}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Today}" Foreground="{StaticResource SidebarMuted}" FontSize="12" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:NavGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource NavGroupHeader}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type shell:NavItem}">
                                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource SidebarHover}" BorderThickness="0,1,0,0" Padding="16,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Foreground="{StaticResource SidebarText}"
                            ToolTip="تسجيل الخروج" Click="OnSignOut">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xF3B1;" Foreground="{StaticResource SidebarText}" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource SidebarMuted}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,12">
                <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="14" Padding="12,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOpenTill}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TillStatus}" FontSize="13" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
