<Window x:Class="MotoParts.Desktop.Views.Shell.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعداد الأول للنظام"
        FlowDirection="RightToLeft"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterScreen"
        Width="980" Height="760" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Sidebar}" Padding="32,22">
            <StackPanel>
                <TextBlock Text="مرحباً بك" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="خطوة واحدة قبل البدء: بيانات المحل، والضريبة، وحساب المالك."
                           Foreground="{StaticResource SidebarText}" FontSize="14" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="بيانات المحل" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="اسم المحل (يظهر على الفواتير) *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ShopName" Margin="0,0,0,10" />
                            <TextBlock Text="العنوان" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Address" Margin="0,0,0,10" />
                            <TextBlock Text="الهاتف" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Phone" Style="{StaticResource NumberBox}" Margin="0,0,0,10" />
                            <TextBlock Text="الرقم الضريبي (15 رقماً، اختياري)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TaxNumber" Style="{StaticResource NumberBox}" Margin="0,0,0,10" />
                            <TextBlock Text="السجل التجاري (اختياري)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CommercialRegister" Style="{StaticResource NumberBox}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ضريبة القيمة المضافة" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="نسبة الضريبة (٪)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TaxPercent" Text="15" Style="{StaticResource NumberBox}" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Text="أدخل 0 إن لم يكن المحل مسجلاً في الضريبة." Style="{StaticResource Muted}" Margin="0,4,0,10" />
                            <CheckBox x:Name="PricesIncludeTax" IsChecked="True" Content="أسعار البيع شاملة الضريبة (المعتاد في البيع للأفراد)" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="حساب المالك" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="هذا الحساب يملك كل الصلاحيات. احفظ كلمة المرور في مكان آمن."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="الاسم الكامل *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OwnerName" Margin="0,0,0,10" />
                            <TextBlock Text="اسم المستخدم (بالإنجليزية، بدون مسافات) *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OwnerUsername" Text="owner" FlowDirection="LeftToRight" Margin="0,0,0,10" />
                            <TextBlock Text="كلمة المرور (6 أحرف على الأقل) *" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="OwnerPassword" FlowDirection="LeftToRight" Margin="0,0,0,10" />
                            <TextBlock Text="تأكيد كلمة المرور *" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="OwnerPasswordConfirm" FlowDirection="LeftToRight" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="بيانات تجريبية" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="LoadDemo" Content="أضف بيانات تجريبية للتعرف على النظام" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20">
                                تُضاف أصناف وعملاء وموردون ويوم بيع كامل، وحسابان للموظفين:
                                <LineBreak />
                                محاسب: <Run Text="accountant" FontWeight="SemiBold" />   بائع: <Run Text="sales" FontWeight="SemiBold" />
                                — وكلمة المرور لكليهما <Run Text="123456" FontWeight="SemiBold" />
                                <LineBreak />
                                لا تخترها إن كنت ستبدأ العمل الفعلي مباشرة.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
            <DockPanel>
                <Button x:Name="FinishButton" DockPanel.Dock="Right" Content="إنهاء الإعداد والبدء" Style="{StaticResource PrimaryButton}"
                        MinWidth="200" MinHeight="42" Click="OnFinish" />
                <Border x:Name="ErrorBox" Background="{StaticResource DangerSoft}" CornerRadius="5" Padding="10,8"
                        Margin="0,0,16,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
