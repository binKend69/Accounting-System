<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:MotoParts.Desktop.Views.Pages"
                    xmlns:forms="clr-namespace:MotoParts.Desktop.Views.Forms"
                    xmlns:controls="clr-namespace:MotoParts.Desktop.Views.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MotoParts;component/Themes/Theme.xaml" />
        <ResourceDictionary Source="/MotoParts;component/Themes/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================== Shift sessions ===================== -->
    <DataTemplate DataType="{x:Type pages:ShiftSessionsViewModel}">
        <DockPanel Margin="24,16">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <controls:DateRangeBar Margin="0,0,16,6" />
                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" Width="170" Margin="0,0,14,6" />
                <CheckBox Content="الورديات ذات الفروقات فقط" IsChecked="{Binding DifferencesOnly}" Margin="0,0,0,6" />
            </WrapPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="تقرير الوردية" Command="{Binding ReportCommand}" Margin="0,0,8,0" />
                    <Button Content="إغلاق إجباري" Style="{StaticResource DangerButton}" Command="{Binding ForceCloseCommand}" Margin="0,0,8,0"
                            Visibility="{Binding CanOverride, Converter={StaticResource Visible}}" />
                    <Button Content="تصحيح العد" Command="{Binding AmendCommand}"
                            Visibility="{Binding CanOverride, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>
            <controls:StatusBanner DockPanel.Dock="Top" />
            <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45" />
                    <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="115" />
                    <DataGridTextColumn Header="الفتح" Binding="{Binding OpenedAt, Converter={StaticResource Date}}" Width="125" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="الإغلاق" Binding="{Binding ClosedAt, Converter={StaticResource Date}}" Width="125" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="العهدة" Binding="{Binding OpeningCash, Converter={StaticResource Money}}" Width="80" ElementStyle="{StaticResource AmountCell}" />
                    <DataGridTextColumn Header="المتوقع" Binding="{Binding ExpectedCash, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource AmountCell}" />
                    <DataGridTextColumn Header="المعدود" Binding="{Binding ActualClosingCash, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource AmountCell}" />
                    <DataGridTemplateColumn Header="الفرق" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CashDifference, Converter={StaticResource Money}}" Style="{StaticResource AmountCellBold}"
                                           Foreground="{Binding CashDifference, Converter={StaticResource SignBrush}, ConverterParameter=signed}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status, Converter={StaticResource Arabic}}" Width="85" />
                    <DataGridTextColumn Header="سبب التدخل" Binding="{Binding OverrideReason}" Width="*" MinWidth="100" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Attendance ===================== -->
    <DataTemplate DataType="{x:Type pages:AttendanceViewModel}">
        <DockPanel Margin="24,16">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <controls:DateRangeBar Margin="0,0,16,6" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="200" Margin="0,0,10,6" ToolTip="اسم الموظف" />
            </WrapPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <Button Content="تصحيح السجل" Command="{Binding CorrectCommand}" HorizontalAlignment="Left" />
            </DockPanel>
            <controls:StatusBanner DockPanel.Dock="Top" />
            <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding WorkDate, Converter={StaticResource Date}}" Width="110" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*" />
                    <DataGridTextColumn Header="الحضور" Binding="{Binding CheckInAt, Converter={StaticResource Date}, ConverterParameter=HH:mm}" Width="90" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="الانصراف" Binding="{Binding CheckOutAt, Converter={StaticResource Date}, ConverterParameter=HH:mm}" Width="90" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="الساعات" Binding="{Binding Worked, StringFormat=hh\\:mm}" Width="80" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type forms:AttendanceForm}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="وقت الحضور (مثل 08:30)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CheckInText}" Style="{StaticResource NumberBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="وقت الانصراف (مثل 17:00)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CheckOutText}" Style="{StaticResource NumberBox}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="سبب التصحيح *" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Reason}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Payroll ===================== -->
    <DataTemplate DataType="{x:Type pages:PayrollViewModel}">
        <DockPanel Margin="24,16">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Content="مسير شهر جديد" Style="{StaticResource PrimaryButton}" Command="{Binding NewRunCommand}" Margin="0,0,8,6" />
                <Button Content="حفظ التعديلات" Command="{Binding SaveLinesCommand}" Margin="0,0,8,6" />
                <Button Content="اعتماد المسير" Style="{StaticResource SuccessButton}" Command="{Binding PostCommand}" Margin="0,0,8,6" />
                <Button Content="صرف الرواتب" Command="{Binding PayCommand}" Margin="0,0,8,6" />
                <Button Content="طباعة المسير" Command="{Binding PrintCommand}" Margin="0,0,8,6" />
                <Button Content="حذف المسودة" Command="{Binding DeleteCommand}" Margin="0,0,0,6" />
            </WrapPanel>
            <controls:StatusBanner DockPanel.Dock="Top" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الشهر" Binding="{Binding PeriodLabel}" Width="80" ElementStyle="{StaticResource LtrCell}" />
                        <DataGridTextColumn Header="الرقم" Binding="{Binding RunNumber}" Width="120" ElementStyle="{StaticResource LtrCell}" />
                        <DataGridTextColumn Header="الصافي" Binding="{Binding TotalNet, Converter={StaticResource Money}}" Width="*" ElementStyle="{StaticResource AmountCellBold}" />
                        <DataGridTemplateColumn Header="الحالة" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource Arabic}}" FontSize="12.5" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="الصافي = الراتب الأساسي + الإضافات (حوافز، إضافي) − الخصومات (غياب، جزاءات). يُعدَّل في المسودة فقط، ثم يُعتمد ويُصرف." />
                    <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="{Binding IsDraft, Converter={StaticResource InvertBool}}" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Line.EmployeeName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="الأساسي" Binding="{Binding Line.BaseSalary, Converter={StaticResource Money}}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource AmountCell}" />
                            <DataGridTextColumn Header="الإضافات" Binding="{Binding AdditionsText, UpdateSourceTrigger=PropertyChanged}" Width="95" ElementStyle="{StaticResource AmountCell}" />
                            <DataGridTextColumn Header="الخصومات" Binding="{Binding DeductionsText, UpdateSourceTrigger=PropertyChanged}" Width="95" ElementStyle="{StaticResource AmountCell}" />
                            <DataGridTextColumn Header="الصافي" Binding="{Binding Line.NetPay, Converter={StaticResource Money}}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource AmountCellBold}" />
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Users ===================== -->
    <DataTemplate DataType="{x:Type pages:UsersViewModel}">
        <DockPanel Margin="24,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="مستخدم جديد" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,0" />
                <Button Content="تعديل" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                <Button Content="إعادة تعيين كلمة المرور" Command="{Binding ResetPasswordCommand}" Margin="0,0,8,0" />
                <Button Content="إيقاف / تفعيل" Command="{Binding ToggleActiveCommand}" />
            </StackPanel>
            <controls:StatusBanner DockPanel.Dock="Top" />
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding User.FullName}" Width="*" />
                    <DataGridTextColumn Header="اسم الدخول" Binding="{Binding User.Username}" Width="140" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="الدور" Binding="{Binding RolesText}" Width="140" />
                    <DataGridTextColumn Header="الرقم الوظيفي" Binding="{Binding User.EmployeeCode}" Width="110" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding User.Phone}" Width="120" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding User.BaseSalary, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource AmountCell}" />
                    <DataGridTextColumn Header="آخر دخول" Binding="{Binding User.LastLoginAt, Converter={StaticResource Date}}" Width="135" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="نشط" Binding="{Binding User.IsActive, Converter={StaticResource YesNo}}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type forms:UserForm}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="الاسم الكامل *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FullName}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="اسم الدخول (إنجليزي بلا مسافات) *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Username}" FlowDirection="LeftToRight" />
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsNew, Converter={StaticResource Visible}}">
                <TextBlock Text="كلمة مرور مؤقتة * (سيُطلب منه تغييرها عند أول دخول)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Password}" FlowDirection="LeftToRight" />
            </StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="الرقم الوظيفي" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EmployeeCode}" FlowDirection="LeftToRight" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="الهاتف" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Phone}" Style="{StaticResource NumberBox}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="تاريخ التعيين" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding HireDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="الراتب الأساسي الشهري" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding BaseSalaryText}" Style="{StaticResource NumberBox}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="الأدوار" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Roles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="المالك: كل الصلاحيات. المحاسب: البيع والاسترجاع والسندات وقراءة الدفاتر وتقاريره. البائع: البيع وورديته فقط." />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Audit log ===================== -->
    <DataTemplate DataType="{x:Type pages:AuditLogViewModel}">
        <DockPanel Margin="24,16">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <controls:DateRangeBar Margin="0,0,16,6" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="200" Margin="0,0,10,6" ToolTip="الموظف أو نوع السجل أو السبب" />
                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Width="160" Margin="0,0,0,6" />
            </WrapPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12"
                    Visibility="{Binding Selected, Converter={StaticResource VisibleIfAny}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="قبل" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Selected.OldValues, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="80" FlowDirection="LeftToRight" FontFamily="Consolas, Segoe UI" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="بعد" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Selected.NewValues, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="80" FlowDirection="LeftToRight" FontFamily="Consolas, Segoe UI" />
                    </StackPanel>
                </Grid>
            </Border>
            <controls:StatusBanner DockPanel.Dock="Top" />
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الوقت" Binding="{Binding CreatedAt, Converter={StaticResource Date}}" Width="135" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="العملية" Binding="{Binding Action, Converter={StaticResource Arabic}}" Width="120" />
                    <DataGridTextColumn Header="السجل" Binding="{Binding AuditableType, Converter={StaticResource AuditType}}" Width="120" />
                    <DataGridTextColumn Header="رقمه" Binding="{Binding AuditableId}" Width="65" />
                    <DataGridTextColumn Header="بواسطة" Binding="{Binding UserName}" Width="140" />
                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*" />
                    <DataGridTextColumn Header="الجهاز" Binding="{Binding MachineName}" Width="150" ElementStyle="{StaticResource LtrCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Reports ===================== -->
    <DataTemplate DataType="{x:Type pages:ReportsViewModel}">
        <Grid Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding Selected}" BorderBrush="{StaticResource Border}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="330" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource SectionTitle}" FontSize="18" />
                    <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <StackPanel Visibility="{Binding Selected.NeedsRange, Converter={StaticResource Visible}}" Margin="0,0,0,12">
                        <TextBlock Text="الفترة (اتركها فارغة للكل)" Style="{StaticResource FieldLabel}" />
                        <controls:DateRangeBar />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Selected.NeedsAccount, Converter={StaticResource Visible}}" Margin="0,0,0,12">
                        <TextBlock Text="الحساب" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Width="360" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Selected.NeedsEmployee, Converter={StaticResource Visible}}" Margin="0,0,0,12">
                        <TextBlock Text="الموظف" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" Width="260" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Selected.NeedsCustomer, Converter={StaticResource Visible}}" Margin="0,0,0,12">
                        <TextBlock Text="العميل" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" Width="300" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Selected.NeedsSupplier, Converter={StaticResource Visible}}" Margin="0,0,0,12">
                        <TextBlock Text="المورد" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" Width="300" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Content="عرض التقرير (PDF)" Style="{StaticResource PrimaryButton}" Command="{Binding ShowCommand}" HorizontalAlignment="Left" MinWidth="200" MinHeight="42" Margin="0,8,0,10" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Text="يُفتح التقرير في عارض PDF؛ اطبعه أو احفظه من هناك." />
                    <controls:StatusBanner Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================== Settings ===================== -->
    <DataTemplate DataType="{x:Type pages:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">
                <controls:StatusBanner />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" IsEnabled="{Binding CanManageSettings}">
                        <StackPanel>
                            <TextBlock Text="بيانات المحل والضريبة" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="اسم المحل" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ShopName}" Margin="0,0,0,8" />
                            <TextBlock Text="العنوان" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Address}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="الهاتف" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Phone}" Style="{StaticResource NumberBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="رمز العملة" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CurrencySymbol}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="الرقم الضريبي" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding TaxNumber}" Style="{StaticResource NumberBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="السجل التجاري" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CommercialRegister}" Style="{StaticResource NumberBox}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="تذييل الفاتورة (سياسة الاستبدال مثلاً)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InvoiceFooter}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="نسبة الضريبة ٪" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding TaxPercentText}" Style="{StaticResource NumberBox}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="أسعار البيع شاملة الضريبة" IsChecked="{Binding PricesIncludeTax}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </Grid>
                            <Button Content="حفظ بيانات المحل" Style="{StaticResource PrimaryButton}" Command="{Binding SaveShopCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding CanManageBackups}">
                            <StackPanel>
                                <TextBlock Text="النسخ الاحتياطي" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="تُؤخذ نسخة تلقائياً كل يوم وعند إغلاق البرنامج. اجعل المجلد على فلاشة أو مجلد متزامن (OneDrive / Google Drive) ليبقى نسخة إن تعطل الجهاز." />
                                <TextBlock Text="مجلد النسخ" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="تصفح..." Command="{Binding BrowseBackupFolderCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding BackupFolder}" FlowDirection="LeftToRight" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="عدد النسخ المحفوظة" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding KeepCountText}" Style="{StaticResource NumberBox}" Width="80" HorizontalAlignment="Left" />
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="حفظ إعدادات النسخ" Command="{Binding SaveBackupSettingsCommand}" Margin="0,0,8,6" />
                                    <Button Content="نسخة احتياطية الآن" Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}" Margin="0,0,8,6" />
                                    <Button Content="استعادة نسخة..." Style="{StaticResource DangerButton}" Command="{Binding RestoreCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Height="170">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الوقت" Binding="{Binding CreatedAt, Converter={StaticResource Date}}" Width="140" ElementStyle="{StaticResource LtrCell}" />
                                        <DataGridTextColumn Header="الملف" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LtrCell}" />
                                        <DataGridTextColumn Header="الحجم" Binding="{Binding SizeLabel}" Width="80" ElementStyle="{StaticResource LtrCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="الحساب والسلامة" Style="{StaticResource SectionTitle}" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="تغيير كلمة المرور" Command="{Binding ChangePasswordCommand}" Margin="0,0,8,6" />
                                    <Button Content="فحص سلامة البيانات" Command="{Binding RunChecksCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding Checks}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0">
                                                    <TextBlock.Text>
                                                        <Binding Path="Passed">
                                                            <Binding.Converter>
                                                                <pages:PassGlyphConverter />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="قاعدة البيانات:" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,0,0,4" />
                                <TextBlock Text="ملفات السجل:" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Text="{Binding LogPath}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
