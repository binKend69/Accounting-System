<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:forms="clr-namespace:MotoParts.Desktop.Views.Forms">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MotoParts;component/Themes/Theme.xaml" />
        <ResourceDictionary Source="/MotoParts;component/Themes/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Small forms whose layout is simple enough to live as templates. -->

    <DataTemplate DataType="{x:Type forms:StockAdjustForm}">
        <StackPanel>
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Product.Sku, Mode=OneWay}" FontWeight="SemiBold" /> — <Run Text="{Binding Product.Name, Mode=OneWay}" />
                    <LineBreak />
                    المسجل في النظام: <Run Text="{Binding Product.StockQty, Converter={StaticResource Qty}, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Product.Unit, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <RadioButton Content="أدخل الكمية المعدودة فعلياً على الرف (الجرد)" IsChecked="{Binding ByCount}" GroupName="AdjustMode" />
            <RadioButton Content="أضف أو اخصم كمية (موجب للزيادة، سالب للنقص)" GroupName="AdjustMode"
                         IsChecked="{Binding ByCount, Converter={StaticResource InvertBool}}" Margin="0,0,0,10" />
            <TextBlock Text="الكمية" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberBox}" FontSize="18" Margin="0,0,0,10" />
            <TextBlock Text="السبب *" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Reason}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                       Text="تُسجَّل قيمة الفرق بالتكلفة في حساب «تسويات المخزون» حتى يبقى حساب المخزون مطابقاً لما على الرفوف." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type forms:OpeningStockForm}">
        <StackPanel>
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Product.Sku, Mode=OneWay}" FontWeight="SemiBold" /> — <Run Text="{Binding Product.Name, Mode=OneWay}" />
                    <LineBreak />
                    للقطع الموجودة على الرفوف عند بدء استخدام النظام. البضاعة الجديدة تُستلم بأمر شراء.
                </TextBlock>
            </Border>
            <TextBlock Text="الكمية الموجودة" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding QuantityText}" Style="{StaticResource NumberBox}" Margin="0,0,0,10" />
            <TextBlock Text="تكلفة الوحدة (سعر الشراء)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding UnitCostText}" Style="{StaticResource NumberBox}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type forms:ProductMovementsForm}">
        <DataGrid ItemsSource="{Binding Movements}" Height="460">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الوقت" Binding="{Binding CreatedAt, Converter={StaticResource Date}}" Width="135" ElementStyle="{StaticResource LtrCell}" />
                <DataGridTextColumn Header="النوع" Binding="{Binding Type, Converter={StaticResource Arabic}}" Width="100" />
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, Converter={StaticResource Qty}}" Width="80" ElementStyle="{StaticResource AmountCellBold}" />
                <DataGridTextColumn Header="الرصيد بعدها" Binding="{Binding BalanceAfter, Converter={StaticResource Qty}}" Width="95" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, Converter={StaticResource Money}}" Width="95" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
                <DataGridTextColumn Header="بواسطة" Binding="{Binding UserName}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>
</ResourceDictionary>
