<UserControl x:Class="MotoParts.Desktop.Views.Forms.PurchaseFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,10" IsEnabled="{Binding IsEditable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="المورد *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding PurchaseDate}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="رقم فاتورة المورد" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SupplierInvoice}" FlowDirection="LeftToRight" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="الدفع" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource Arabic}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="8">
                <TextBlock Text="الضريبة ٪" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TaxPercentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberBox}" />
            </StackPanel>
        </Grid>

        <!-- Add a part -->
        <DockPanel Margin="0,0,0,8" Visibility="{Binding IsEditable, Converter={StaticResource Visible}}">
            <Button DockPanel.Dock="Right" Content="إضافة صنف" Command="{Binding FindProductCommand}" Margin="8,0,0,0" />
            <TextBox x:Name="ProductBox" Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnProductKeyDown"
                     ToolTip="امسح الباركود أو اكتب رمز الصنف أو جزءاً من اسمه ثم Enter" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" MaxHeight="160" Margin="0,0,0,8"
                  MouseDoubleClick="OnResultDoubleClick" Visibility="{Binding HasResults, Converter={StaticResource Visible}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرمز" Binding="{Binding Sku}" Width="110" ElementStyle="{StaticResource LtrCell}" />
                <DataGridTextColumn Header="الصنف (نقرتان للإضافة)" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="المتوفر" Binding="{Binding StockQty, Converter={StaticResource Qty}}" Width="80" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="آخر تكلفة" Binding="{Binding CostPrice, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource AmountCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Lines -->
        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsReadOnly="{Binding IsEditable, Converter={StaticResource InvertBool}}"
                  Height="260" RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرمز" Binding="{Binding Sku}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource LtrCell}" />
                <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource AmountCellBold}" />
                <DataGridTextColumn Header="تكلفة الوحدة (بدون ضريبة)" Binding="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}" Width="160" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, Converter={StaticResource Money}}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource AmountCellBold}" />
                <DataGridTemplateColumn Width="44" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Padding="4" ToolTip="حذف السطر"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{StaticResource Danger}" FontSize="14" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals and options -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Notes}" IsReadOnly="{Binding IsEditable, Converter={StaticResource InvertBool}}" Margin="0,0,0,10" />
                <CheckBox Content="استلام البضاعة فوراً عند الحفظ (تدخل المخزون ويُسجَّل القيد)" IsChecked="{Binding ReceiveNow}">
                    <CheckBox.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueVisible}">
                            <Binding Path="IsEditable" />
                            <Binding Path="CanReceive" />
                        </MultiBinding>
                    </CheckBox.Visibility>
                </CheckBox>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal, Converter={StaticResource Money}}" FlowDirection="LeftToRight" /><TextBlock Text="قبل الضريبة" /></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Tax, Converter={StaticResource Money}}" FlowDirection="LeftToRight" /><TextBlock Text="الضريبة" /></DockPanel>
                    <DockPanel Margin="0,6,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Total, Converter={StaticResource Money}}" FlowDirection="LeftToRight" FontWeight="Bold" FontSize="18" /><TextBlock Text="الإجمالي" FontWeight="Bold" FontSize="16" /></DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
