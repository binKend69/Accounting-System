<UserControl x:Class="MotoParts.Desktop.Views.Forms.ExpenseFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:MotoParts.Desktop.Views.Forms">
    <StackPanel>
        <TextBlock Text="نوع المصروف *" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" DisplayMemberPath="Label" Margin="0,0,0,10" />
        <TextBlock Text="البيان *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Description}" Margin="0,0,0,10" />
        <TextBlock Text="المستفيد (اختياري)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Payee}" Margin="0,0,0,10" />
        <forms:VoucherFields />
    </StackPanel>
</UserControl>
