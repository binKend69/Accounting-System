<UserControl x:Class="MotoParts.Desktop.Views.Forms.ProductFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="رمز الصنف (SKU) *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Sku}" FlowDirection="LeftToRight" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="الباركود (اختياري، امسحه بالقارئ)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Barcode}" FlowDirection="LeftToRight" />
            </StackPanel>
        </Grid>
        <TextBlock Text="اسم الصنف *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Name}" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="الفئة" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="الماركة" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Brand}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="الوحدة *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Units}" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
            </StackPanel>
        </Grid>
        <TextBlock Text="يناسب الموديلات (مثل: Honda CG125 2004-2012)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding FitsModels}" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="سعر البيع *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SellingPriceText}" Style="{StaticResource NumberBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="التكلفة المتوقعة" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding CostPriceText}" Style="{StaticResource NumberBox}" IsReadOnly="{Binding CostIsEditable, Converter={StaticResource InvertBool}}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="حد إعادة الطلب" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ReorderLevelText}" Style="{StaticResource NumberBox}" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                   Text="بعد أول استلام تُحسب التكلفة تلقائياً كمتوسط لما دُفع فعلاً، ولا تُعدَّل يدوياً. الكمية تتغير فقط بالمشتريات والمبيعات والجرد." />
        <TextBlock Text="{Binding StockInfo}" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding StockInfo, Converter={StaticResource VisibleIfAny}}" />
        <TextBlock Text="وصف (اختياري)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Description}" Margin="0,0,0,10" />
        <CheckBox Content="صنف نشط (يظهر في البيع)" IsChecked="{Binding IsActive}" />
    </StackPanel>
</UserControl>
