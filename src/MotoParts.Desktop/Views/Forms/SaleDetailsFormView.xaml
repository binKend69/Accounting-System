<UserControl x:Class="MotoParts.Desktop.Views.Forms.SaleDetailsFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <UniformGrid Columns="4" Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding Sale.SoldAt, Converter={StaticResource Date}}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="البائع" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding Seller}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="العميل" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="الدفع / الحالة" Style="{StaticResource FieldLabel}" />
                <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding Sale.PaymentMethod, Converter={StaticResource Arabic}, Mode=OneWay}" /> — <Run Text="{Binding Sale.Status, Converter={StaticResource Arabic}, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </UniformGrid>

        <DataGrid ItemsSource="{Binding Items}" MaxHeight="320">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرمز" Binding="{Binding Sku}" Width="100" ElementStyle="{StaticResource LtrCell}" />
                <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, Converter={StaticResource Qty}}" Width="70" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="الخصم" Binding="{Binding Discount, Converter={StaticResource Money}}" Width="80" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource AmountCellBold}" />
                <DataGridTextColumn Header="المرتجع" Binding="{Binding RefundedQuantity, Converter={StaticResource Qty}}" Width="70" ElementStyle="{StaticResource AmountCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Sale.Notes}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Sale.Subtotal, Converter={StaticResource Money}}" FlowDirection="LeftToRight" /><TextBlock Text="المجموع" /></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Sale.DiscountTotal, Converter={StaticResource Money}}" FlowDirection="LeftToRight" /><TextBlock Text="الخصم" /></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Sale.TaxTotal, Converter={StaticResource Money}}" FlowDirection="LeftToRight" /><TextBlock Text="الضريبة" /></DockPanel>
                    <DockPanel Margin="0,6,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Sale.Total, Converter={StaticResource Money}}" FlowDirection="LeftToRight" FontWeight="Bold" FontSize="16" /><TextBlock Text="الإجمالي" FontWeight="Bold" FontSize="16" /></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Sale.CogsTotal, Converter={StaticResource Money}}" FlowDirection="LeftToRight" Style="{StaticResource Muted}" /><TextBlock Text="تكلفة البضاعة" Style="{StaticResource Muted}" /></DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRefunds, Converter={StaticResource Visible}}">
            <TextBlock Text="المرتجعات على هذه الفاتورة" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding Refunds}" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الإشعار" Binding="{Binding RefundNumber}" Width="140" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding RefundDate, Converter={StaticResource Date}}" Width="100" ElementStyle="{StaticResource LtrCell}" />
                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*" />
                    <DataGridTextColumn Header="الطريقة" Binding="{Binding PaymentMethod, Converter={StaticResource Arabic}}" Width="90" />
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Total, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource AmountCellBold}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </StackPanel>
</UserControl>
