<UserControl x:Class="MotoParts.Desktop.Views.Pages.VoucherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MotoParts.Desktop.Views.Controls">
    <DockPanel Margin="24,16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <controls:DateRangeBar Margin="0,0,16,6" />
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="240" Margin="0,0,10,6"
                     ToolTip="رقم السند أو الاسم أو البيان" />
        </WrapPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding NewLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                <Button Content="طباعة السند" Command="{Binding PrintCommand}" Margin="0,0,8,0" />
                <Button Content="إلغاء السند" Style="{StaticResource DangerButton}" Command="{Binding VoidCommand}"
                        Visibility="{Binding CanVoid, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DockPanel>
        <controls:StatusBanner DockPanel.Dock="Top" />
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVoided}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم السند" Binding="{Binding Number}" Width="140" ElementStyle="{StaticResource LtrCell}" />
                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, Converter={StaticResource Date}}" Width="100" ElementStyle="{StaticResource LtrCell}" />
                <DataGridTextColumn Binding="{Binding PartyName}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.PartyHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="البيان / المرجع" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="الطريقة" Binding="{Binding PaymentMethod, Converter={StaticResource Arabic}}" Width="100" />
                <DataGridTextColumn Header="من الدرج" Binding="{Binding ThroughDrawer, Converter={StaticResource YesNo}}" Width="75" />
                <DataGridTextColumn Header="بواسطة" Binding="{Binding UserName}" Width="130" />
                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource AmountCellBold}" />
                <DataGridTextColumn Header="الإلغاء" Binding="{Binding VoidReason}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
