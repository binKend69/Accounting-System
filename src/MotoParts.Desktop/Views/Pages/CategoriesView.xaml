<UserControl x:Class="MotoParts.Desktop.Views.Pages.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MotoParts.Desktop.Views.Controls">
    <DockPanel Margin="24,16" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="فئة جديدة" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,0" />
            <Button Content="إعادة تسمية" Command="{Binding RenameCommand}" Margin="0,0,8,0" />
            <Button Content="إيقاف / تفعيل" Command="{Binding ToggleActiveCommand}" Margin="0,0,8,0" />
            <Button Content="حذف" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <controls:StatusBanner DockPanel.Dock="Top" />
        <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding Selected}" Width="760" HorizontalAlignment="Left">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الفئة" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ProductCount}" Width="110" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="نشطة" Binding="{Binding IsActive, Converter={StaticResource YesNo}}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
