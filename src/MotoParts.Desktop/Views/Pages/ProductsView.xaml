<UserControl x:Class="MotoParts.Desktop.Views.Pages.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MotoParts.Desktop.Views.Controls">
    <DockPanel Margin="24,16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="280" Margin="0,0,10,6"
                     ToolTip="الرمز أو الباركود أو الاسم أو الماركة أو الموديل" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="170" Margin="0,0,14,6" />
            <CheckBox Content="النشطة فقط" IsChecked="{Binding ActiveOnly}" Margin="0,0,14,6" />
            <CheckBox Content="تحت حد الطلب فقط" IsChecked="{Binding LowStockOnly}" Margin="0,0,0,6" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <WrapPanel>
                <Button Content="صنف جديد" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,6"
                        Visibility="{Binding CanManage, Converter={StaticResource Visible}}" />
                <Button Content="تعديل" Command="{Binding EditCommand}" Margin="0,0,8,6"
                        Visibility="{Binding CanManage, Converter={StaticResource Visible}}" />
                <Button Content="جرد / تسوية" Command="{Binding AdjustCommand}" Margin="0,0,8,6"
                        Visibility="{Binding CanAdjust, Converter={StaticResource Visible}}" />
                <Button Content="رصيد افتتاحي" Command="{Binding OpeningStockCommand}" Margin="0,0,8,6"
                        Visibility="{Binding CanAdjust, Converter={StaticResource Visible}}" />
                <Button Content="حركات الصنف" Command="{Binding MovementsCommand}" Margin="0,0,8,6" />
                <Button Content="حذف" Command="{Binding DeleteCommand}" Margin="0,0,16,6"
                        Visibility="{Binding CanManage, Converter={StaticResource Visible}}" />
                <Button Content="طباعة ورقة الجرد" Style="{StaticResource LinkButton}" Command="{Binding PrintStockListCommand}" Margin="0,0,4,6" />
                <Button Content="طباعة قائمة إعادة الطلب" Style="{StaticResource LinkButton}" Command="{Binding PrintLowStockCommand}" Margin="0,0,0,6" />
            </WrapPanel>
        </DockPanel>

        <controls:StatusBanner DockPanel.Dock="Top" />

        <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}" MouseDoubleClick="OnDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرمز" Binding="{Binding Sku}" Width="100" ElementStyle="{StaticResource LtrCell}" />
                <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="الفئة" Binding="{Binding CategoryName}" Width="110" />
                <DataGridTextColumn Header="الماركة" Binding="{Binding Brand}" Width="90" />
                <DataGridTextColumn Header="يناسب" Binding="{Binding FitsModels}" Width="*" />
                <DataGridTemplateColumn Header="المتوفر" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StockQty, Converter={StaticResource Qty}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AmountCellBold}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="60" />
                <DataGridTextColumn Header="حد الطلب" Binding="{Binding ReorderLevel, Converter={StaticResource Qty}}" Width="75" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="سعر البيع" Binding="{Binding SellingPrice, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource AmountCellBold}" />
                <DataGridTextColumn x:Name="CostColumn" Header="متوسط التكلفة" Binding="{Binding CostPrice, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn x:Name="ValueColumn" Header="قيمة المخزون" Binding="{Binding StockValue, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource AmountCell}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
