<Window x:Class="HisabTak.WPF.Views.StockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="حساب تك | المبيعات والمخزون" Width="1090" Height="760" MinWidth="890" MinHeight="620" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="#F4F7F9">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#E3EDF0"/><Setter Property="Foreground" Value="#173947"/><Setter Property="BorderBrush" Value="#B4C9CF"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinWidth" Value="130"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinWidth" Value="80"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="RowHeight" Value="32"/><Setter Property="AlternatingRowBackground" Value="#F1F6F7"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#DDE7EA"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Margin" Value="4"/></Style>
  <Style x:Key="ReturnFields" TargetType="WrapPanel">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedValue, ElementName=Kind}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding SelectedValue, ElementName=Kind}" Value="5"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <DockPanel Margin="16"><TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="23" FontWeight="SemiBold"/>
 <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#13586E" AutomationProperties.LiveSetting="Polite"/>
 <WrapPanel x:Name="PosCommands" Visibility="Collapsed" DockPanel.Dock="Top">
   <Button Content="فاتورة ١" Tag="1" Click="SwitchPos"/><Button Content="فاتورة ٢" Tag="2" Click="SwitchPos"/>
   <Button Content="فاتورة ٣" Tag="3" Click="SwitchPos"/><Button Content="فاتورة ٤" Tag="4" Click="SwitchPos"/>
   <Button Content="حفظ الخانة" Click="SavePos"/><Button x:Name="PayPosButton" Content="دفع وترحيل" Click="PayPos"/>
   <Button Content="طابعة الفاتورة" Click="ChooseReceiptPrinter"/><Button Content="طابعة المطبخ" Click="ChooseKitchenPrinter"/>
   <Button x:Name="ReprintReceipt" Content="إعادة طباعة الفاتورة" Click="RepeatReceipt"/><Button x:Name="ReprintKitchen" Content="إعادة تذكرة المطبخ" Click="RepeatKitchen"/>
   <Button Content="استعادة آخر حفظ" Click="ReloadPos"/>
  </WrapPanel>
  <TabControl x:Name="Tabs">
  <TabItem x:Name="InvoiceTab" Header="المستند">
   <TabItem.CommandBindings><CommandBinding Command="ApplicationCommands.Find" Executed="FocusProductSearch"/></TabItem.CommandBindings>
   <TabItem.InputBindings><KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/></TabItem.InputBindings><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
   <TextBlock Text="{Binding SelectedItem.Label, ElementName=Kind}" FontSize="24" FontWeight="SemiBold" Foreground="#214859"/><WrapPanel><TextBlock Text="النوع"/><ComboBox x:Name="Kind" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBlock Text="التاريخ"/><DatePicker x:Name="EntryDate" Width="145"/><CheckBox x:Name="Credit" Content="آجل" VerticalAlignment="Center" Margin="12"/><TextBlock Text="حساب العميل أو المورد أو النقدية"/><ComboBox x:Name="Party"/></WrapPanel>
   <WrapPanel><TextBlock Text="المستودع"/><ComboBox x:Name="Warehouse"/><TextBlock Text="العملة"/><ComboBox x:Name="InvoiceCurrency"/><TextBlock Text="سعرها إلى الأساس"/><TextBox x:Name="InvoiceRate" Text="1"/><WrapPanel><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=Kind}" Value="6"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><TextBlock Text="إلى مستودع"/><ComboBox x:Name="Target"/></WrapPanel></WrapPanel>
   <StackPanel x:Name="CustomsFields"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=Kind}" Value="11"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <WrapPanel><TextBlock Text="البيان الجمركي"/><ComboBox x:Name="DeclarationType" SelectedIndex="0"><ComboBoxItem Content="استيراد"/><ComboBoxItem Content="تصدير"/></ComboBox><TextBlock Text="بلد المنشأ"/><TextBox x:Name="OriginCountry" MaxLength="100"/><TextBlock Text="نوع البضاعة"/><TextBox x:Name="GoodsType" MaxLength="200"/></WrapPanel>
   <WrapPanel><TextBlock Text="عدد وسائل النقل"/><TextBox x:Name="VehicleCount" Text="1"/><TextBlock Text="رقم القاطرة"/><TextBox x:Name="VehicleNumber" MaxLength="50"/></WrapPanel>
   <WrapPanel><TextBlock Text="رقم سجل فاتورة الشراء المرحلة"/><TextBox x:Name="FeePurchase"/><Button Click="LoadFeePurchase" Content="تحميل أصناف الفاتورة"/>
   <TextBlock Text="وزن السطر المحدد (كغ)"/><TextBox x:Name="FeeWeight"/><Button Click="ApplyFeeWeight" Content="تعيين الوزن"/></WrapPanel>
   <WrapPanel><TextBlock Text="المعالجة المعتمدة للحساب"/><ComboBox x:Name="FeePolicy" SelectedIndex="0"><ComboBoxItem Content="تكلفة حسب القيمة"/><ComboBoxItem Content="تكلفة حسب الوزن"/><ComboBoxItem Content="مصروف"/><ComboBoxItem Content="ضريبة مستردة"/></ComboBox><Button Content="حفظ قاعدة حساب الرسم" Click="ConfigureFee"/></WrapPanel>
   <WrapPanel><TextBlock Text="حساب الرسم"/><ComboBox x:Name="FeeAccount"/><TextBlock Text="المبلغ بعملة المستند"/><TextBox x:Name="FeeAmount"/><Button Content="إضافة رسم" Click="AddFee"/></WrapPanel>
   <WrapPanel><ListBox x:Name="Fees" MinWidth="220"/><Button Content="حذف الرسم المحدد" Click="RemoveFee"/></WrapPanel></StackPanel>
   <WrapPanel x:Name="DepartmentButtons" Visibility="Collapsed"/><WrapPanel x:Name="TouchItems" Visibility="Collapsed"/>
   <WrapPanel><CheckBox x:Name="TaxEnabled" Content="تطبيق الضريبة" VerticalAlignment="Center"/><TextBlock Text="النسبة %"/><TextBox x:Name="TaxRate" Text="0"/><CheckBox x:Name="Inclusive" Content="السعر شامل الضريبة" VerticalAlignment="Center"/></WrapPanel>
   <Border Background="#E5EFF1" Padding="8"><DockPanel><Button x:Name="AddCatalogItem" DockPanel.Dock="Right" Content="＋ إضافة صنف جديد" Click="OpenProductEntry"/><TextBlock Text="أصناف المستند" FontSize="18" FontWeight="SemiBold"/></DockPanel></Border>
   <WrapPanel><Label Target="{Binding ElementName=ProductSearch}" Content="بحث باسم الصنف أو رمزه (Ctrl+F)"/>
    <TextBox Name="ProductSearch" Width="145" TextChanged="ProductSearchChanged" ToolTip="أدخل حرفين على الأقل"/>
    <ComboBox Name="ProductMatches" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="نتائج بحث الأصناف"/>
    <Button Name="ChooseProductButton" Content="اختيار نتيجة البحث" Click="ChooseProduct"/></WrapPanel>
   <WrapPanel><TextBlock Text="باركود الوحدة"/><TextBox x:Name="ScanCode"/><Button Content="اختيار بالباركود" Click="Scan"/><TextBlock Text="شريحة السعر"/><TextBox x:Name="SaleTier" Text="تجزئة"/><Button Content="جلب سعر الوحدة بعملة المستند" Click="Quote"/></WrapPanel>
   <WrapPanel><TextBlock Text="الصنف"/><ComboBox x:Name="Item"/><TextBlock Text="الوحدة"/><ComboBox x:Name="Unit"/><TextBlock Text="الكمية"/><TextBox x:Name="Quantity" Text="1"/><TextBlock Text="سعر الوحدة"/><TextBox x:Name="Price" Text="0"/><TextBlock Text="خصم السطر"/><TextBox x:Name="Discount" Text="0"/></WrapPanel>
   <WrapPanel><TextBlock Text="الدفعة"/><ComboBox x:Name="Batch"/><TextBlock Text="سبب الاختيار اليدوي"/><TextBox x:Name="Reason" Width="170"/></WrapPanel><WrapPanel Style="{StaticResource ReturnFields}"><Button Content="اختيار الفاتورة الأصلية" Click="FindReturnInvoice"/><TextBlock Text="رقم حركة الأصل"/><TextBox x:Name="Original"/></WrapPanel>
   <WrapPanel><Button x:Name="AddStockLineButton" Content="إضافة السطر" Click="AddLine"/><Button Content="حذف المحدد" Click="RemoveLine"/></WrapPanel>
   <DataGrid x:Name="Lines" Height="170"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Product}" Width="2*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="*"/><DataGridTextColumn Header="الوزن (كغ)" Binding="{Binding Line.ShippingWeight}"/><DataGridTextColumn Header="الكمية" Binding="{Binding Line.Quantity}" Width="*"/><DataGridTextColumn Header="السعر" Binding="{Binding Line.UnitPrice}" Width="*"/><DataGridTextColumn Header="الخصم" Binding="{Binding Line.Discount}" Width="*"/><DataGridTextColumn Header="الحركة الأصلية" Binding="{Binding Line.OriginalMovementId}" Width="*"/></DataGrid.Columns></DataGrid>
   <WrapPanel x:Name="DocumentCommands"><Button x:Name="NewStockDocumentButton" Content="مستند جديد" Click="NewDocument"/><Button x:Name="SaveButton" Foreground="White" Background="#166477" Content="حفظ المسودة" Click="Save"/><Button x:Name="ConvertButton" Content="تحويل إلى مسودة فاتورة" Click="ConvertIntent" Visibility="Collapsed"/><Button x:Name="PostButton" Content="ترحيل النسخة المحفوظة" Click="Post"/><TextBlock Text="تاريخ العكس"/><DatePicker x:Name="ReverseDate" Width="140"/><Button x:Name="PreviewButton" Content="معاينة وطباعة" Click="Preview"/><Button x:Name="PrintSaleButton" Content="طباعة فاتورة البيع" Click="RepeatReceipt"/><Button x:Name="KitchenCopyButton" Content="طباعة تذكرة المطبخ" Click="RepeatKitchen"/><Button x:Name="ReverseButton" Content="عكس المستند" Click="Reverse"/></WrapPanel>
   <Expander x:Name="MovementDetails" Header="تفاصيل الحركات والدفعات المرحلة"><StackPanel><Button Content="إنشاء مردود من الحركة المحددة" Click="ReturnMovement" HorizontalAlignment="Right"/><DataGrid x:Name="Moves" Height="115"><DataGrid.Columns><DataGridTextColumn Header="رقم الحركة" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductId}" Width="*"/><DataGridTextColumn Header="الدفعة" Binding="{Binding BatchId}" Width="*"/><DataGridTextColumn Header="الكمية الأساسية" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="أثر المخزون" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="الصافي" Binding="{Binding Net}" Width="*"/><DataGridTextColumn Header="الضريبة" Binding="{Binding Tax}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="سجل المستندات"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="فتح المحدد" Click="Open"/><Button Content="تحديث" Click="Refresh"/><Button Content="السابق" Click="Previous"/><Button Content="التالي" Click="Next"/></WrapPanel><ListBox x:Name="Documents" DisplayMemberPath="Label"/></DockPanel></TabItem>
  <TabItem Header="تاريخ البيع والشراء" x:Name="HistoryTab"><DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <WrapPanel><TextBlock Text="من"/><DatePicker x:Name="HistoryFrom" Width="135"/><TextBlock Text="إلى"/><DatePicker x:Name="HistoryTo" Width="135"/><TextBlock Text="الصنف"/><ComboBox x:Name="HistoryProduct"/><TextBlock Text="المستودع"/><ComboBox x:Name="HistoryWarehouse"/><TextBlock Text="النوع"/><ComboBox x:Name="HistoryKind"/></WrapPanel>
    <WrapPanel><Button x:Name="HistorySearchButton" Content="بحث" Click="SearchHistory"/><Button x:Name="HistoryPreviousButton" Content="السابق" Click="PreviousHistory"/><Button x:Name="HistoryNextButton" Content="التالي" Click="NextHistory"/><TextBlock x:Name="HistoryPageText"/><Button x:Name="HistoryOpenButton" Content="فتح المستند وتفاصيل الدفعات" Click="OpenHistory"/><Button Content="فتح أصل المردود" Click="OpenHistoryOriginal"/></WrapPanel>
    <TextBlock Text="المبالغ بعملة المستند، والأثر المخزني بعملة الأساس. السطر المعكوس ظاهر للتتبع وليس رصيداً قائماً. أسعار وخصومات أصل المردود تخص وحدة وسطر الأصل؛ صافي المردود وضريبته هما حصته الفعلية. الأسماء المعروضة هي أسماء المراجع الحالية." TextWrapping="Wrap"/>
   </StackPanel>
   <DataGrid x:Name="HistoryGrid" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="105"/>
    <DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="95"/>
    <DataGridTextColumn Header="رقم المستند" Binding="{Binding Row.Number}" Width="100"/>
    <DataGridTextColumn Header="هوية المستند" Binding="{Binding Row.DocumentId}" Width="100"/>
    <DataGridTextColumn Header="الحالة" Binding="{Binding State}" Width="80"/>
    <DataGridTextColumn Header="تاريخ العكس" Binding="{Binding ReversalDate}" Width="105"/>
    <DataGridTextColumn Header="الصنف" Binding="{Binding Row.Product}" Width="180"/>
    <DataGridTextColumn Header="سطر" Binding="{Binding Row.LineNumber}" Width="50"/>
    <DataGridTextColumn Header="الوحدة" Binding="{Binding Row.Unit}" Width="80"/>
    <DataGridTextColumn Header="المستودع" Binding="{Binding Row.Warehouse}" Width="130"/>
    <DataGridTextColumn Header="حساب الطرف" Binding="{Binding Row.Party}" Width="160"/>
    <DataGridTextColumn Header="الدفع" Binding="{Binding Payment}" Width="65"/>
    <DataGridTextColumn Header="العملة" Binding="{Binding Row.Currency}" Width="70"/>
    <DataGridTextColumn Header="سعر التحويل" Binding="{Binding Row.RateToBase}" Width="100"/>
    <DataGridTextColumn Header="الكمية" Binding="{Binding Row.Quantity}" Width="80"/>
    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding Price}" Width="90"/>
    <DataGridTextColumn Header="خصم السطر" Binding="{Binding Discount}" Width="90"/>
    <DataGridTextColumn Header="الضريبة" Binding="{Binding TaxMode}" Width="120"/>
    <DataGridTextColumn Header="النسبة" Binding="{Binding TaxRate}" Width="70"/>
    <DataGridTextColumn Header="الصافي" Binding="{Binding Row.Net}" Width="95"/>
    <DataGridTextColumn Header="قيمة الضريبة" Binding="{Binding Row.Tax}" Width="95"/>
    <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total}" Width="100"/>
    <DataGridTextColumn Header="أثر كمية الأساس" Binding="{Binding Row.BaseQuantity}" Width="110"/>
    <DataGridTextColumn Header="التكلفة التاريخية الموقعة بالأساس" Binding="{Binding Row.HistoricalCost}" Width="175"/>
    <DataGridTextColumn Header="فرق التقييم بالأساس" Binding="{Binding Row.ValuationDifference}" Width="135"/>
    <DataGridTextColumn Header="أثر قيمة المخزون بالأساس" Binding="{Binding Row.StockValue}" Width="160"/>
    <DataGridTextColumn Header="حركة الأصل" Binding="{Binding Row.OriginalMovementId}" Width="95"/>
    <DataGridTextColumn Header="مستند الأصل" Binding="{Binding Row.OriginalDocumentId}" Width="95"/>
    <DataGridTextColumn Header="تاريخ الأصل" Binding="{Binding OriginalDate}" Width="105"/>
    <DataGridTextColumn Header="سعر الأصل" Binding="{Binding Row.OriginalUnitPrice}" Width="95"/>
    <DataGridTextColumn Header="وحدة الأصل" Binding="{Binding Row.OriginalUnit}" Width="90"/>
    <DataGridTextColumn Header="رقم القيد" Binding="{Binding Row.JournalId}" Width="95"/>
    <DataGridTextColumn Header="وقت الترحيل UTC" Binding="{Binding Row.PostedAtUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="175"/>
    <DataGridTextColumn Header="رحله المستخدم" Binding="{Binding Row.PostedBy}" Width="130"/>
    <DataGridTextColumn Header="خصم سطر الأصل" Binding="{Binding Row.OriginalDiscount}" Width="110"/>
   </DataGrid.Columns></DataGrid>
  </DockPanel></TabItem>
  <TabItem x:Name="BalancesTab" Header="الأرصدة والذمم"><StackPanel><WrapPanel><TextBlock Text="أرصدة المخزون في تاريخ"/><DatePicker x:Name="AsOf" Width="140"/><Button Content="عرض الأرصدة" Click="Refresh"/><Button Content="تاريخ بيع وشراء الصنف منذ بداية السنة" Click="OpenBalanceHistory"/></WrapPanel>
   <DataGrid x:Name="Balances" Height="150"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Product}" Width="2*"/><DataGridTextColumn Header="المستودع" Binding="{Binding Warehouse}" Width="2*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Balance.Quantity}" Width="*"/><DataGridTextColumn Header="القيمة الدفترية بالأساس" Binding="{Binding Balance.BookValue}" Width="*"/><DataGridTextColumn Header="آخر سعر شراء بوحدة الأساس" Binding="{Binding Balance.LastPurchasePrice}" Width="1.4*"/></DataGrid.Columns></DataGrid>
   <TextBlock Text="الذمم الحالية"/><DataGrid x:Name="Debts" Height="160"><DataGrid.Columns><DataGridTextColumn Header="رقم سجل الفاتورة" Binding="{Binding DocumentId}" Width="*"/><DataGridTemplateColumn Header="الاتجاه"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="مستحق علينا"/><Style.Triggers><DataTrigger Binding="{Binding Receivable}" Value="True"><Setter Property="Text" Value="مستحق لنا"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="حساب الطرف" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="مبلغ الفاتورة" Binding="{Binding OriginalAmount}" Width="*"/><DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount}" Width="*"/></DataGrid.Columns></DataGrid>
   <WrapPanel><TextBlock Text="حساب النقدية"/><ComboBox x:Name="Cash"/><TextBlock Text="المسدد من أصل الدين"/><TextBox x:Name="Payment"/><TextBlock Text="النقد الفعلي بعملة حساب النقدية"/><TextBox x:Name="CashAmount"/><TextBlock Text="سعر النقد إلى الأساس"/><TextBox x:Name="CashRate"/><TextBlock Text="التاريخ"/><DatePicker x:Name="PaymentDate" Width="140"/><Button Content="تسجيل سداد للفاتورة المحددة" Click="Settle"/></WrapPanel>
  </StackPanel></TabItem>
  <TabItem x:Name="ProductSetupTab" Header="دليل الأصناف"><ScrollViewer><StackPanel Margin="12">
   <TextBlock Text="دليل الأصناف" FontSize="23" FontWeight="SemiBold"/>
   <DataGrid x:Name="Catalog" Height="155" SelectionChanged="CatalogSelected"><DataGrid.Columns>
    <DataGridTextColumn Header="رمز الصنف" Binding="{Binding Code}" Width="*"/>
    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding Name}" Width="2*"/>
   </DataGrid.Columns></DataGrid>
   <TextBlock Text="إضافة صنف" Foreground="#185768" FontSize="20"/><WrapPanel><TextBlock Text="الكود (اختياري)"/><TextBox x:Name="Code"/><TextBlock Text="الاسم"/><TextBox x:Name="ProductName"/><TextBlock Text="وحدة الأساس"/><ComboBox x:Name="BaseUnit"/><TextBlock Text="طريقة التكلفة"/><ComboBox x:Name="Method" SelectedIndex="0"><ComboBoxItem Content="المتوسط المرجح"/><ComboBoxItem Content="آخر شراء"/></ComboBox><CheckBox x:Name="ServiceItem" Content="خدمة دون خصم مخزون" VerticalAlignment="Center"/><TextBlock Text="قسم الكاشير"/><ComboBox x:Name="ItemDepartment"/><CheckBox x:Name="KitchenItem" Content="طباعة بالمطبخ"/><CheckBox x:Name="Tracked" Content="تتبع الدفعات" VerticalAlignment="Center"/><Button Content="إنشاء الصنف" Click="CreateProduct"/></WrapPanel>
   <WrapPanel><Button Content="تطبيق القسم والطباعة على الصنف المحدد" Click="UpdateCashierProduct"/>
   <TextBlock Text="لون القسم (#RRGGBB)"/><TextBox x:Name="DepartmentColor" Text="#166477"/><TextBlock Text="ترتيب القسم"/><TextBox x:Name="DepartmentOrder" Text="0"/>
   <Button Content="حفظ لون وترتيب القسم" Click="SaveDepartment"/></WrapPanel>
   <TextBlock Text="تُثبّت طريقة تكلفة الصنف بعد أول حركة. حدّد معالجة فرق آخر شراء في إعداد الفرع قبل ترحيل شراء بسعر مختلف." TextWrapping="Wrap"/>
   <Separator Margin="4,12"/><WrapPanel><TextBlock Text="الصنف"/><ComboBox x:Name="SetupProduct"/><ComboBox x:Name="ExistingMethod" SelectedIndex="0"><ComboBoxItem Content="المتوسط المرجح"/><ComboBoxItem Content="آخر شراء"/></ComboBox><Button Content="تغيير الطريقة قبل أول حركة" Click="ChangeMethod"/></WrapPanel>
   <WrapPanel><TextBlock Text="وحدة إضافية"/><ComboBox x:Name="ExtraUnit"/><TextBlock Text="عدد الوحدات الأساسية فيها"/><TextBox x:Name="Factor" Text="1"/><Button Content="حفظ التحويل" Click="CreateUnit"/></WrapPanel>
   <WrapPanel><TextBlock Text="وحدة الباركود والسعر"/><ComboBox x:Name="PriceUnit"/><TextBlock Text="الباركود"/><TextBox x:Name="SetupBarcode"/><Button Content="ربط الباركود" Click="SetBarcode"/></WrapPanel>
   <WrapPanel><TextBlock Text="الشريحة"/><TextBox x:Name="SetupTier" Text="تجزئة"/><TextBlock Text="العملة"/><ComboBox x:Name="PriceCurrency"/><TextBlock Text="السعر"/><TextBox x:Name="SetupPrice"/><Button Content="حفظ سعر الوحدة" Click="SetPrice"/></WrapPanel>
   <WrapPanel><TextBlock Text="المستودع"/><ComboBox x:Name="BatchWarehouse"/><TextBlock Text="رمز الدفعة"/><TextBox x:Name="BatchCode"/><TextBlock Text="الصلاحية"/><DatePicker x:Name="Expiry" Width="135"/><Button Content="إنشاء الدفعة" Click="CreateBatch"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem><TabItem Header="إعداد الفرع"><ScrollViewer><StackPanel Margin="12"><TextBlock Text="حسابات ترحيل الفرع بعملة الأساس" FontSize="20"/>
   <UniformGrid Columns="3"><StackPanel><TextBlock Text="المخزون"/><ComboBox x:Name="StockAccount"/></StackPanel><StackPanel><TextBlock Text="المبيعات"/><ComboBox x:Name="SalesAccount"/></StackPanel><StackPanel><TextBlock Text="مردودات المبيعات"/><ComboBox x:Name="SalesReturnsAccount"/></StackPanel><StackPanel><TextBlock Text="تكلفة المبيعات"/><ComboBox x:Name="CostAccount"/></StackPanel><StackPanel><TextBlock Text="تسويات المخزون"/><ComboBox x:Name="Adjustment"/></StackPanel><StackPanel><TextBlock Text="ضريبة المدخلات"/><ComboBox x:Name="InputTax"/></StackPanel><StackPanel><TextBlock Text="ضريبة المخرجات"/><ComboBox x:Name="OutputTax"/></StackPanel><StackPanel><TextBlock Text="أرباح الصرف"/><ComboBox x:Name="FxGain"/></StackPanel><StackPanel><TextBlock Text="خسائر الصرف"/><ComboBox x:Name="FxLoss"/></StackPanel></UniformGrid>
   <WrapPanel><TextBlock Text="معالجة فرق آخر شراء"/><ComboBox x:Name="BookPolicy" SelectedIndex="1"><ComboBoxItem Content="لم يحدد بعد"/><ComboBoxItem Content="حفظ قيمة الاقتناء"/><ComboBoxItem Content="إعادة التقييم — إعداد تاريخي" IsEnabled="False"/></ComboBox></WrapPanel>
   <WrapPanel><TextBlock Text="حساب العميل"/><ComboBox x:Name="LimitCustomer"/><TextBlock Text="حد الائتمان بعملة الحساب"/><TextBox x:Name="LimitAmount"/><Button Content="حفظ حد الائتمان" Click="SetLimit"/></WrapPanel>
   <WrapPanel><TextBlock Text="دقة العملة الإضافية"/><ComboBox x:Name="CurrencySettings"/><TextBox x:Name="Decimals" Text="2"/><Button Content="تثبيت الدقة" Click="SetPrecision"/></WrapPanel>
   <Button Content="حفظ حسابات الفرع" HorizontalAlignment="Right" Click="Configure"/>
  </StackPanel></ScrollViewer></TabItem>
 </TabControl></DockPanel>
</Window>
