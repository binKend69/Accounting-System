<Window x:Class="HisabTak.WPF.Views.StockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="حساب تك | المبيعات والمخزون" Width="1090" Height="760" MinWidth="890" MinHeight="620" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="#F4F7F9">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinWidth" Value="130"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinWidth" Value="80"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Margin" Value="4"/></Style>
 </Window.Resources>
 <DockPanel Margin="16"><TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="23" FontWeight="SemiBold"/>
 <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#13586E" AutomationProperties.LiveSetting="Polite"/>
 <TabControl x:Name="Tabs">
  <TabItem Header="المستند"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
   <WrapPanel><TextBlock Text="النوع"/><ComboBox x:Name="Kind" DisplayMemberPath="Label" SelectedValuePath="Id"/><TextBlock Text="التاريخ"/><DatePicker x:Name="EntryDate" Width="145"/><CheckBox x:Name="Credit" Content="آجل" VerticalAlignment="Center" Margin="12"/><TextBlock Text="حساب العميل أو المورد أو النقدية"/><ComboBox x:Name="Party"/></WrapPanel>
   <WrapPanel><TextBlock Text="المستودع"/><ComboBox x:Name="Warehouse"/><TextBlock Text="إلى مستودع (للتحويل)"/><ComboBox x:Name="Target"/></WrapPanel>
   <WrapPanel><CheckBox x:Name="TaxEnabled" Content="تطبيق الضريبة" VerticalAlignment="Center"/><TextBlock Text="النسبة %"/><TextBox x:Name="TaxRate" Text="0"/><CheckBox x:Name="Inclusive" Content="السعر شامل الضريبة" VerticalAlignment="Center"/></WrapPanel>
   <Separator Margin="4,12"/>
   <WrapPanel><TextBlock Text="الصنف"/><ComboBox x:Name="Item"/><TextBlock Text="الوحدة"/><ComboBox x:Name="Unit"/><TextBlock Text="الكمية"/><TextBox x:Name="Quantity" Text="1"/><TextBlock Text="سعر الوحدة"/><TextBox x:Name="Price" Text="0"/><TextBlock Text="خصم السطر"/><TextBox x:Name="Discount" Text="0"/></WrapPanel>
   <WrapPanel><TextBlock Text="الدفعة"/><ComboBox x:Name="Batch"/><TextBlock Text="سبب الاختيار اليدوي"/><TextBox x:Name="Reason" Width="170"/><TextBlock Text="رقم حركة الأصل للمردود"/><TextBox x:Name="Original"/></WrapPanel>
   <WrapPanel><Button x:Name="AddStockLineButton" Content="إضافة السطر" Click="AddLine"/><Button Content="حذف المحدد" Click="RemoveLine"/></WrapPanel>
   <DataGrid x:Name="Lines" Height="170"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Product}" Width="2*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Line.Quantity}" Width="*"/><DataGridTextColumn Header="السعر" Binding="{Binding Line.UnitPrice}" Width="*"/><DataGridTextColumn Header="الخصم" Binding="{Binding Line.Discount}" Width="*"/><DataGridTextColumn Header="الحركة الأصلية" Binding="{Binding Line.OriginalMovementId}" Width="*"/></DataGrid.Columns></DataGrid>
   <WrapPanel><Button Content="مستند جديد" Click="NewDocument"/><Button x:Name="SaveButton" Content="حفظ المسودة" Click="Save"/><Button x:Name="PostButton" Content="ترحيل النسخة المحفوظة" Click="Post"/><TextBlock Text="تاريخ العكس"/><DatePicker x:Name="ReverseDate" Width="140"/><Button x:Name="PreviewButton" Content="معاينة وطباعة" Click="Preview"/><Button x:Name="ReverseButton" Content="عكس المستند" Click="Reverse"/></WrapPanel>
   <DataGrid x:Name="Moves" Height="115"><DataGrid.Columns><DataGridTextColumn Header="رقم الحركة" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductId}" Width="*"/><DataGridTextColumn Header="الدفعة" Binding="{Binding BatchId}" Width="*"/><DataGridTextColumn Header="الكمية الأساسية" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="أثر المخزون" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="الصافي" Binding="{Binding Net}" Width="*"/><DataGridTextColumn Header="الضريبة" Binding="{Binding Tax}" Width="*"/></DataGrid.Columns></DataGrid>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="سجل المستندات"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="فتح المحدد" Click="Open"/><Button Content="تحديث" Click="Refresh"/><Button Content="السابق" Click="Previous"/><Button Content="التالي" Click="Next"/></WrapPanel><ListBox x:Name="Documents" DisplayMemberPath="Label"/></DockPanel></TabItem>
  <TabItem Header="الأرصدة والذمم"><StackPanel><WrapPanel><TextBlock Text="أرصدة المخزون في تاريخ"/><DatePicker x:Name="AsOf" Width="140"/><Button Content="عرض الأرصدة" Click="Refresh"/></WrapPanel>
   <DataGrid x:Name="Balances" Height="150"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Product}" Width="2*"/><DataGridTextColumn Header="المستودع" Binding="{Binding Warehouse}" Width="2*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="القيمة" Binding="{Binding BookValue}" Width="*"/></DataGrid.Columns></DataGrid>
   <TextBlock Text="الذمم الحالية"/><DataGrid x:Name="Debts" Height="160"><DataGrid.Columns><DataGridTextColumn Header="رقم سجل الفاتورة" Binding="{Binding DocumentId}" Width="*"/><DataGridTemplateColumn Header="الاتجاه"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="مستحق علينا"/><Style.Triggers><DataTrigger Binding="{Binding Receivable}" Value="True"><Setter Property="Text" Value="مستحق لنا"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="حساب الطرف" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="مبلغ الفاتورة" Binding="{Binding OriginalAmount}" Width="*"/><DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount}" Width="*"/></DataGrid.Columns></DataGrid>
   <WrapPanel><TextBlock Text="حساب النقدية"/><ComboBox x:Name="Cash"/><TextBlock Text="المبلغ"/><TextBox x:Name="Payment"/><TextBlock Text="التاريخ"/><DatePicker x:Name="PaymentDate" Width="140"/><Button Content="تسجيل سداد للفاتورة المحددة" Click="Settle"/></WrapPanel>
  </StackPanel></TabItem>
  <TabItem Header="الأصناف والإعداد"><ScrollViewer><StackPanel Margin="12">
   <TextBlock Text="تعريف صنف" FontSize="20"/><WrapPanel><TextBlock Text="الكود"/><TextBox x:Name="Code"/><TextBlock Text="الاسم"/><TextBox x:Name="ProductName"/><TextBlock Text="وحدة الأساس"/><ComboBox x:Name="BaseUnit"/><ComboBox x:Name="Method" SelectedIndex="0"><ComboBoxItem Content="المتوسط المرجح"/><ComboBoxItem Content="آخر شراء"/></ComboBox><CheckBox x:Name="Tracked" Content="تتبع الدفعات" VerticalAlignment="Center"/><Button Content="إنشاء الصنف" Click="CreateProduct"/></WrapPanel>
   <TextBlock Text="عند اختيار آخر شراء، يعاد تقييم الرصيد المتبقي عند الشراء ويسجل الفرق في حساب التسوية." TextWrapping="Wrap"/>
   <Separator Margin="4,12"/><WrapPanel><TextBlock Text="الصنف"/><ComboBox x:Name="SetupProduct"/><ComboBox x:Name="ExistingMethod" SelectedIndex="0"><ComboBoxItem Content="المتوسط المرجح"/><ComboBoxItem Content="آخر شراء"/></ComboBox><Button Content="تغيير الطريقة قبل أول حركة" Click="ChangeMethod"/></WrapPanel>
   <WrapPanel><TextBlock Text="وحدة إضافية"/><ComboBox x:Name="ExtraUnit"/><TextBlock Text="عدد الوحدات الأساسية فيها"/><TextBox x:Name="Factor" Text="1"/><Button Content="حفظ التحويل" Click="CreateUnit"/></WrapPanel>
   <WrapPanel><TextBlock Text="المستودع"/><ComboBox x:Name="BatchWarehouse"/><TextBlock Text="رمز الدفعة"/><TextBox x:Name="BatchCode"/><TextBlock Text="الصلاحية"/><DatePicker x:Name="Expiry" Width="135"/><Button Content="إنشاء الدفعة" Click="CreateBatch"/></WrapPanel>
   <Separator Margin="4,12"/><TextBlock Text="حسابات ترحيل الفرع بعملة الأساس" FontSize="20"/>
   <UniformGrid Columns="3"><StackPanel><TextBlock Text="المخزون"/><ComboBox x:Name="StockAccount"/></StackPanel><StackPanel><TextBlock Text="المبيعات"/><ComboBox x:Name="SalesAccount"/></StackPanel><StackPanel><TextBlock Text="تكلفة المبيعات"/><ComboBox x:Name="CostAccount"/></StackPanel><StackPanel><TextBlock Text="تسويات المخزون"/><ComboBox x:Name="Adjustment"/></StackPanel><StackPanel><TextBlock Text="ضريبة المدخلات"/><ComboBox x:Name="InputTax"/></StackPanel><StackPanel><TextBlock Text="ضريبة المخرجات"/><ComboBox x:Name="OutputTax"/></StackPanel></UniformGrid>
   <Button Content="حفظ حسابات الفرع" HorizontalAlignment="Right" Click="Configure"/>
  </StackPanel></ScrollViewer></TabItem>
 </TabControl></DockPanel>
</Window>
