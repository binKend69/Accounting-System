<Window x:Class="HisabTak.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حسابك — مساحة العمل المحاسبية" Language="ar-YE" FlowDirection="RightToLeft"
        Width="1220" Height="820" MinWidth="980" MinHeight="700" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#E5EDF4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="110"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/><Setter Property="MinWidth" Value="150"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right"><TextBlock Text="مساحة العمل المحاسبية" FontSize="27" FontWeight="SemiBold" Foreground="#153A4A"/><TextBlock Text="المستندات • الحسابات • الفترات" Foreground="#576579" Margin="0,5"/></StackPanel>
            <Button x:Name="LogoutButton" Content="تسجيل الخروج" Click="Logout_Click" DockPanel.Dock="Left" Visibility="Collapsed" HorizontalAlignment="Left"/>
        </DockPanel>
        <Border x:Name="LoginPanel" Grid.Row="1" Background="White" CornerRadius="12" Padding="40" MaxWidth="460" VerticalAlignment="Center">
            <StackPanel><TextBlock Text="تسجيل الدخول" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <TextBlock Text="اسم المستخدم"/><TextBox x:Name="Username" AutomationProperties.Name="اسم المستخدم"/>
                <TextBlock Text="كلمة المرور" Margin="0,12,0,0"/><PasswordBox x:Name="Password" Padding="10" Margin="4" AutomationProperties.Name="كلمة المرور"/>
                <Button Content="دخول" Click="Login_Click" Background="#155E75" Foreground="White" Margin="4,20,4,4" IsDefault="True"/>
                <TextBlock Text="تُستخدم قاعدة المنشأة المحددة في إعدادات الاتصال." TextWrapping="Wrap" Foreground="#576579" Margin="4,12"/>
            </StackPanel>
        </Border>
        <Grid x:Name="WorkspacePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="الفرع" VerticalAlignment="Center"/><ComboBox x:Name="BranchBox" Width="260" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Branch_Changed"/><TextBlock x:Name="UserLabel" VerticalAlignment="Center" Margin="20,0"/></StackPanel>
            <TabControl Grid.Row="1" Background="White" BorderThickness="0" Padding="16">
                <TabItem Header="المستندات">
                    <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><Button Content="تحديث القائمة" Click="Refresh_Click"/><Button Content="مستند جديد" Click="New_Click"/></StackPanel>
                            <ListBox x:Name="DocumentList" Grid.Row="1" Margin="4" MouseDoubleClick="Open_Click" AutomationProperties.Name="المستندات">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Caption}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="#576579" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="فتح المحدد" Click="Open_Click"/><Button Content="السابق" Click="Previous_Click"/><Button Content="التالي" Click="Next_Click"/></StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Margin="18,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="DocumentTitle" Text="مستند جديد" FontSize="22" FontWeight="SemiBold" Foreground="#153A4A"/>
                            <WrapPanel Grid.Row="1" Margin="0,12"><ComboBox x:Name="TypeBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="قيد يومية" Tag="JOURNAL_VOUCHER"/><ComboBoxItem Content="قيد افتتاحي" Tag="JOURNAL_OPENING"/><ComboBoxItem Content="سند قبض" Tag="RECEIPT_VOUCHER"/><ComboBoxItem Content="سند صرف" Tag="PAYMENT_VOUCHER"/></ComboBox><DatePicker x:Name="EntryDate" Margin="8" Width="135" AutomationProperties.Name="تاريخ المستند"/></WrapPanel>
                            <DataGrid x:Name="LinesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="42" Margin="0,0,0,8" AutomationProperties.Name="سطور المستند">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="الحساب" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Accounts, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding AccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="120"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="الجانب" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Side, Mode=TwoWay}" MinWidth="80"><ComboBoxItem Content="مدين" Tag="1"/><ComboBoxItem Content="دائن" Tag="2"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="سعر الأساس" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="3"><Button x:Name="AddLineButton" Content="إضافة سطر" Click="AddLine_Click"/><Button x:Name="RemoveLineButton" Content="حذف السطر" Click="RemoveLine_Click"/><TextBlock Text="المبلغ بعملة الحساب • سعر التحويل إلى عملة الأساس" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#576579"/></WrapPanel>
                            <StackPanel Grid.Row="4"><WrapPanel><Button x:Name="SaveButton" Content="حفظ المسودة" Click="Save_Click"/><Button x:Name="PostButton" Content="ترحيل النسخة المحفوظة" Click="Post_Click" Background="#155E75" Foreground="White"/><Button x:Name="PrintButton" Content="معاينة / طباعة" Click="Print_Click"/></WrapPanel><WrapPanel><DatePicker x:Name="ReversalDate" Width="135" Margin="8" AutomationProperties.Name="تاريخ العكس"/><Button x:Name="ReverseButton" Content="إلغاء بعكس" Click="Reverse_Click"/></WrapPanel></StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="الحسابات والإعداد المالي"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Right">
                    <TextBlock Text="إنشاء حساب للفرع المحدد" FontSize="22" Margin="0,0,0,12"/>
                    <WrapPanel><TextBox x:Name="AccountCode" Width="160" ToolTip="رمز الحساب" AutomationProperties.Name="رمز الحساب"/><TextBox x:Name="AccountName" Width="260" ToolTip="اسم الحساب" AutomationProperties.Name="اسم الحساب"/></WrapPanel>
                    <WrapPanel><ComboBox x:Name="GroupBox" DisplayMemberPath="Label" SelectedValuePath="Id" ToolTip="مجموعة الحساب"/><ComboBox x:Name="CurrencyBox" DisplayMemberPath="Label" SelectedValuePath="Id" ToolTip="عملة الحساب"/><ComboBox x:Name="NatureBox" SelectedIndex="0"><ComboBoxItem Content="طبيعة مدينة" Tag="1"/><ComboBoxItem Content="طبيعة دائنة" Tag="2"/></ComboBox></WrapPanel>
                    <WrapPanel><ComboBox x:Name="GeneralGroupBox" DisplayMemberPath="Label" SelectedValuePath="Id" ToolTip="تصنيف اختياري: صندوق أو بنك أو عميل أو مورد"/><Button Content="إنشاء الحساب" Click="CreateAccount_Click"/></WrapPanel>
                    <Separator Margin="0,20"/><TextBlock Text="عملة الأساس وحساب فرق التقريب" FontSize="22"/>
                    <TextBlock Text="اختر حسابًا مستقلاً للفروق بعملة الأساس وفي الفرع المحدد. دقة العملات الأولية منزلتان." TextWrapping="Wrap" Margin="0,8"/>
                    <WrapPanel><ComboBox x:Name="BaseCurrencyBox" DisplayMemberPath="Label" SelectedValuePath="Id"/><Button Content="حفظ عملة الأساس" Click="BaseCurrency_Click"/></WrapPanel>
                    <WrapPanel><ComboBox x:Name="RoundingAccountBox" DisplayMemberPath="Label" SelectedValuePath="Id" Width="280"/><TextBox x:Name="PrecisionBox" Text="2" Width="70" MinWidth="60" ToolTip="دقة عملة الأساس"/><Button Content="حفظ إعداد التقريب" Click="Rounding_Click"/></WrapPanel>
                    <Separator Margin="0,20"/><TextBlock Text="الفترات المالية" FontSize="22"/>
                    <TextBlock Text="أدخل رقم الفترة الموجودة. الإقفال وإعادة الفتح يتطلبان صلاحيات مستقلة." TextWrapping="Wrap" Margin="0,8"/>
                    <WrapPanel><TextBox x:Name="PeriodIdBox" Width="100" ToolTip="رقم الفترة"/><Button Content="إقفال الفترة" Click="ClosePeriod_Click"/><Button Content="إعادة فتح الفترة" Click="ReopenPeriod_Click"/></WrapPanel>
                </StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Background="#E5EDF4" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Text="مرحبًا. سجل الدخول لفتح مستندات المنشأة." TextWrapping="Wrap" Foreground="#153A4A" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
</Window>
